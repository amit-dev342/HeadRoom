<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/taskCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minWidth="300dp"
    android:minHeight="220dp"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/widget_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/taskStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ACTIVE"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="10sp"
            android:letterSpacing=".12" />

        <TextView
            android:id="@+id/taskPriority"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MEDIUM PRIORITY"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="10sp"
            android:letterSpacing=".08" />
    </LinearLayout>

    <TextView
        android:id="@+id/taskTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="24sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingTop="18dp" />

    <TextView
        android:id="@+id/taskWeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#F6E9C9"
        android:alpha=".82"
        android:textSize="12sp"
        android:paddingTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="18dp">

        <TextView
            android:id="@+id/taskDue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#F6E9C9"
            android:alpha=".82"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/taskTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="120dp"
            android:textColor="#F6E9C9"
            android:alpha=".82"
            android:textStyle="bold"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/taskNotes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="No notes"
        android:textColor="#F6E9C9"
        android:alpha=".74"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:gravity="center_vertical" />

    <TextView
        android:id="@+id/taskAction"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="○  MARK COMPLETE"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="11sp"
        android:letterSpacing=".08"
        android:background="@drawable/widget_action" />
</LinearLayout>